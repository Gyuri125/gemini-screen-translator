# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Global Hotkeys (pynput syntax: <alt>+t, <ctrl>+<shift>+z, etc.)
HOTKEY=<alt>+t
HISTORY_HOTKEY=<alt>+h

# Default Target Language
# Options: English, Hungarian, German, Japanese, French, Spanish, Italian, Russian, Chinese, Korean, Portuguese
TARGET_LANGUAGE=English

# Result Display Mode:
# "lens"    : In-Place Lens Overlay (replaces foreign text directly in the original location)
# "compact" : Floating Subtitle HUD (floating card right below the crop)
# "window"  : Full Detailed Window (multi-pane window with original text and telemetry)
OVERLAY_MODE=compact

# Automatically copy translated text to the system clipboard (true / false)
AUTO_COPY=false

# Automatically speak translated text aloud via Windows native TTS (true / false)
AUTO_TTS=false