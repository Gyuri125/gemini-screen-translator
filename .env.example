# Google Gemini API Key (Get a free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Global Hotkeys (pynput syntax: <alt>+t, <ctrl>+<shift>+z, etc.)
HOTKEY=<alt>+t
HISTORY_HOTKEY=<alt>+h

# Default Target Language
# Options: English, Hungarian, German, Japanese, French, Spanish, Italian, Russian, Chinese, Korean, Portuguese
TARGET_LANGUAGE=English

# Result Overlay Mode: "compact" (floating in-game subtitle) or "window" (full detailed window)
OVERLAY_MODE=compact

# Automatically copy translated text to the system clipboard (true / false)
AUTO_COPY=false